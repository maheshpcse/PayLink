{
  "name": "paylink-ui",
  "version": "1.0.0",
  "description": "PayLink Angular customer payment companion UI",
  "engines": {
    "node": "24.19.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "ng build --configuration development --no-progress"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "jsdom": "30.1.3",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "vitest": "5.0.0"
  }
}
