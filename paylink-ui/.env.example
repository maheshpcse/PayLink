# Optional Docker runtime settings. Angular CLI does not implicitly read .env files.
# nginx proxies same-origin /api requests to this trusted test backend.
PAYLINK_API_UPSTREAM=http://paylink-server:4000

# Browser-only non-secret configuration is in public/paylink-config.js, or in
# src/environments/environment.ts for Angular build configurations.
# No API passwords, bearer tokens, or payment-provider secrets belong in the UI.
