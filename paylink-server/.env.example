NODE_ENV=development
PORT=4000
# Angular CLI serves paylink-ui on port 8200 by default.
PAYLINK_CORS_ORIGINS=http://localhost:8200,http://127.0.0.1:8200,http://localhost:3000,http://127.0.0.1:3000
PAYLINK_WEBHOOK_SECRET=dev-only-change-this-webhook-secret
PAYLINK_DEMO_USERS=true
# Development allows the Angular app's reloads, polling and parallel account calls.
# Use a lower shared-store-backed limit in production.
PAYLINK_RATE_LIMIT_MAX=1000
PAYLINK_RATE_LIMIT_WINDOW_MS=60000
PAYLINK_BODY_LIMIT_BYTES=1000000

# Local MySQL settings for the migration/seed commands. The HTTP demo remains
# memory-backed until the runtime repository cutover is completed.
PAYLINK_PERSISTENCE=memory
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=paylink
MYSQL_USER=paylink
MYSQL_PASSWORD=change-me
MYSQL_SSL=false

# Optional notification transport settings. Keep mock transport for local work.
PAYLINK_EMAIL_TRANSPORT=mock
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PayLink <no-reply@example.test>
PAYLINK_OTP_TTL_SECONDS=600
PAYLINK_OTP_MAX_ATTEMPTS=5
