NODE_ENV=development
PORT=4000
# Vite serves the existing paylink-ui on port 4173 by default.
PAYLINK_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000
PAYLINK_WEBHOOK_SECRET=dev-only-change-this-webhook-secret
PAYLINK_DEMO_USERS=true
PAYLINK_RATE_LIMIT_MAX=120
PAYLINK_RATE_LIMIT_WINDOW_MS=60000
PAYLINK_BODY_LIMIT_BYTES=1000000
